{
  "$defs": {
    "BoxScore": {
      "additionalProperties": false,
      "properties": {
        "player_id": {
          "minLength": 1,
          "title": "Player Id",
          "type": "string"
        },
        "game_id": {
          "minLength": 1,
          "title": "Game Id",
          "type": "string"
        },
        "team_id": {
          "minLength": 1,
          "title": "Team Id",
          "type": "string"
        },
        "played_at": {
          "format": "date-time",
          "title": "Played At",
          "type": "string"
        },
        "known_at": {
          "format": "date-time",
          "title": "Known At",
          "type": "string"
        },
        "minutes": {
          "minimum": 0,
          "title": "Minutes",
          "type": "number"
        },
        "stats": {
          "additionalProperties": {
            "minimum": 0,
            "type": "number"
          },
          "title": "Stats",
          "type": "object"
        }
      },
      "required": [
        "player_id",
        "game_id",
        "team_id",
        "played_at",
        "known_at",
        "minutes",
        "stats"
      ],
      "title": "BoxScore",
      "type": "object"
    },
    "SeasonGame": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "home": {
          "minLength": 1,
          "title": "Home",
          "type": "string"
        },
        "away": {
          "minLength": 1,
          "title": "Away",
          "type": "string"
        },
        "tipoff": {
          "format": "date-time",
          "title": "Tipoff",
          "type": "string"
        },
        "known_at": {
          "format": "date-time",
          "title": "Known At",
          "type": "string"
        },
        "status": {
          "enum": [
            "scheduled",
            "in_progress",
            "completed",
            "postponed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "home",
        "away",
        "tipoff",
        "known_at",
        "status"
      ],
      "title": "SeasonGame",
      "type": "object"
    },
    "SeasonPlayer": {
      "additionalProperties": false,
      "properties": {
        "provider_ids": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "default": {},
          "title": "Provider Ids",
          "type": "object"
        },
        "team_abbreviation": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team Abbreviation"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "team_id": {
          "minLength": 1,
          "title": "Team Id",
          "type": "string"
        },
        "positions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Positions",
          "type": "array"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "known_at": {
          "format": "date-time",
          "title": "Known At",
          "type": "string"
        },
        "public_rank": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Public Rank"
        },
        "ownership": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ownership"
        },
        "ownership_change": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ownership Change"
        },
        "return_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return On"
        }
      },
      "required": [
        "id",
        "name",
        "team_id",
        "positions",
        "status",
        "known_at",
        "public_rank",
        "ownership",
        "ownership_change"
      ],
      "title": "SeasonPlayer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "season_id": {
      "minLength": 1,
      "title": "Season Id",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "players": {
      "items": {
        "$ref": "#/$defs/SeasonPlayer"
      },
      "title": "Players",
      "type": "array"
    },
    "games": {
      "items": {
        "$ref": "#/$defs/SeasonGame"
      },
      "title": "Games",
      "type": "array"
    },
    "boxes": {
      "items": {
        "$ref": "#/$defs/BoxScore"
      },
      "title": "Boxes",
      "type": "array"
    }
  },
  "required": [
    "format_version",
    "season_id",
    "source",
    "as_of",
    "players",
    "games",
    "boxes"
  ],
  "title": "PlayerSnapshot",
  "type": "object"
}
