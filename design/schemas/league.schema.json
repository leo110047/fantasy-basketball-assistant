{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "field_path",
        "evidence"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Category": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "formula": {
          "discriminator": {
            "mapping": {
              "linear": "#/$defs/Linear",
              "ratio": "#/$defs/Ratio"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Linear"
            },
            {
              "$ref": "#/$defs/Ratio"
            }
          ],
          "title": "Formula"
        },
        "direction": {
          "enum": [
            "higher",
            "lower"
          ],
          "title": "Direction",
          "type": "string"
        },
        "comparison_decimals": {
          "maximum": 12,
          "minimum": 0,
          "title": "Comparison Decimals",
          "type": "integer"
        },
        "tie_value": {
          "maximum": 1,
          "minimum": 0,
          "title": "Tie Value",
          "type": "number"
        }
      },
      "required": [
        "id",
        "label",
        "formula",
        "direction",
        "comparison_decimals",
        "tie_value"
      ],
      "title": "Category",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Assumption",
            "source",
            "backtest"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reference",
        "as_of",
        "reason"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "InjurySlot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "eligible_statuses": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Eligible Statuses",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "count",
        "eligible_statuses"
      ],
      "title": "InjurySlot",
      "type": "object"
    },
    "Linear": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "linear",
          "title": "Kind",
          "type": "string"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/Term"
          },
          "minItems": 1,
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "terms"
      ],
      "title": "Linear",
      "type": "object"
    },
    "Lineup": {
      "additionalProperties": false,
      "properties": {
        "lock_mode": {
          "enum": [
            "daily",
            "weekly"
          ],
          "title": "Lock Mode",
          "type": "string"
        },
        "lock_at": {
          "enum": [
            "period_start",
            "first_game",
            "player_game"
          ],
          "title": "Lock At",
          "type": "string"
        },
        "lock_local_time": {
          "format": "time",
          "title": "Lock Local Time",
          "type": "string"
        }
      },
      "required": [
        "lock_mode",
        "lock_at",
        "lock_local_time"
      ],
      "title": "Lineup",
      "type": "object"
    },
    "Matchup": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "phase": {
          "enum": [
            "regular",
            "playoff",
            "postseason"
          ],
          "title": "Phase",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "phase"
      ],
      "title": "Matchup",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start",
        "end"
      ],
      "title": "Period",
      "type": "object"
    },
    "Playoffs": {
      "additionalProperties": false,
      "properties": {
        "team_count": {
          "exclusiveMinimum": 0,
          "title": "Team Count",
          "type": "integer"
        },
        "week_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Week Ids",
          "type": "array"
        },
        "seeding": {
          "items": {
            "enum": [
              "record",
              "head_to_head",
              "category_record",
              "seed"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Seeding",
          "type": "array"
        },
        "byes": {
          "minimum": 0,
          "title": "Byes",
          "type": "integer"
        },
        "reseed": {
          "title": "Reseed",
          "type": "boolean"
        },
        "matchup_tie": {
          "enum": [
            "higher_seed",
            "category_record"
          ],
          "title": "Matchup Tie",
          "type": "string"
        }
      },
      "required": [
        "team_count",
        "week_ids",
        "seeding",
        "byes",
        "reseed",
        "matchup_tie"
      ],
      "title": "Playoffs",
      "type": "object"
    },
    "Ratio": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ratio",
          "title": "Kind",
          "type": "string"
        },
        "numerator": {
          "items": {
            "$ref": "#/$defs/Term"
          },
          "minItems": 1,
          "title": "Numerator",
          "type": "array"
        },
        "denominator": {
          "items": {
            "$ref": "#/$defs/Term"
          },
          "minItems": 1,
          "title": "Denominator",
          "type": "array"
        },
        "zero_denominator": {
          "enum": [
            "error",
            "zero",
            "numerator"
          ],
          "title": "Zero Denominator",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "numerator",
        "denominator",
        "zero_denominator"
      ],
      "title": "Ratio",
      "type": "object"
    },
    "Scoring": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "h2h_one_win",
          "title": "Mode",
          "type": "string"
        },
        "week_tie": {
          "enum": [
            "tie",
            "half_win",
            "loss"
          ],
          "title": "Week Tie",
          "type": "string"
        },
        "category_ties": {
          "enum": [
            "exclude",
            "use_tie_value"
          ],
          "title": "Category Ties",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "week_tie",
        "category_ties"
      ],
      "title": "Scoring",
      "type": "object"
    },
    "StarterSlot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "eligible_positions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Eligible Positions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "eligible_positions"
      ],
      "title": "StarterSlot",
      "type": "object"
    },
    "Term": {
      "additionalProperties": false,
      "properties": {
        "stat_id": {
          "minLength": 1,
          "title": "Stat Id",
          "type": "string"
        },
        "coefficient": {
          "title": "Coefficient",
          "type": "number"
        }
      },
      "required": [
        "stat_id",
        "coefficient"
      ],
      "title": "Term",
      "type": "object"
    },
    "Transactions": {
      "additionalProperties": false,
      "properties": {
        "adds_per_period": {
          "minimum": 0,
          "title": "Adds Per Period",
          "type": "integer"
        },
        "add_periods": {
          "items": {
            "$ref": "#/$defs/Period"
          },
          "minItems": 1,
          "title": "Add Periods",
          "type": "array"
        },
        "effective": {
          "enum": [
            "same_day",
            "next_day"
          ],
          "title": "Effective",
          "type": "string"
        },
        "cutoff_local_time": {
          "format": "time",
          "title": "Cutoff Local Time",
          "type": "string"
        },
        "waiver_days": {
          "minimum": 0,
          "title": "Waiver Days",
          "type": "integer"
        }
      },
      "required": [
        "adds_per_period",
        "add_periods",
        "effective",
        "cutoff_local_time",
        "waiver_days"
      ],
      "title": "Transactions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "league_id": {
      "minLength": 1,
      "title": "League Id",
      "type": "string"
    },
    "teams": {
      "minimum": 2,
      "title": "Teams",
      "type": "integer"
    },
    "budget": {
      "exclusiveMinimum": 0,
      "title": "Budget",
      "type": "integer"
    },
    "minimum_bid": {
      "exclusiveMinimum": 0,
      "title": "Minimum Bid",
      "type": "integer"
    },
    "bid_increment": {
      "exclusiveMinimum": 0,
      "title": "Bid Increment",
      "type": "integer"
    },
    "timezone": {
      "minLength": 1,
      "title": "Timezone",
      "type": "string"
    },
    "positions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Positions",
      "type": "array"
    },
    "starter_slots": {
      "items": {
        "$ref": "#/$defs/StarterSlot"
      },
      "minItems": 1,
      "title": "Starter Slots",
      "type": "array"
    },
    "bench_slots": {
      "minimum": 0,
      "title": "Bench Slots",
      "type": "integer"
    },
    "injury_slots": {
      "items": {
        "$ref": "#/$defs/InjurySlot"
      },
      "title": "Injury Slots",
      "type": "array"
    },
    "categories": {
      "items": {
        "$ref": "#/$defs/Category"
      },
      "minItems": 1,
      "title": "Categories",
      "type": "array"
    },
    "scoring": {
      "$ref": "#/$defs/Scoring"
    },
    "transactions": {
      "$ref": "#/$defs/Transactions"
    },
    "lineup": {
      "$ref": "#/$defs/Lineup"
    },
    "matchups": {
      "items": {
        "$ref": "#/$defs/Matchup"
      },
      "minItems": 1,
      "title": "Matchups",
      "type": "array"
    },
    "playoffs": {
      "$ref": "#/$defs/Playoffs"
    },
    "trade_deadline": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Trade Deadline"
    },
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    }
  },
  "required": [
    "format_version",
    "league_id",
    "teams",
    "budget",
    "minimum_bid",
    "bid_increment",
    "timezone",
    "positions",
    "starter_slots",
    "bench_slots",
    "injury_slots",
    "categories",
    "scoring",
    "transactions",
    "lineup",
    "matchups",
    "playoffs",
    "trade_deadline",
    "assumptions"
  ],
  "title": "LeagueRules",
  "type": "object"
}
