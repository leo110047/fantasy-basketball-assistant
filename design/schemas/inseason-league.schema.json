{
  "$defs": {
    "Category": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "formula": {
          "discriminator": {
            "mapping": {
              "linear": "#/$defs/Linear",
              "ratio": "#/$defs/Ratio"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Linear"
            },
            {
              "$ref": "#/$defs/Ratio"
            }
          ],
          "title": "Formula"
        },
        "direction": {
          "enum": [
            "higher",
            "lower"
          ],
          "title": "Direction",
          "type": "string"
        },
        "comparison_decimals": {
          "maximum": 12,
          "minimum": 0,
          "title": "Comparison Decimals",
          "type": "integer"
        },
        "tie_value": {
          "maximum": 1,
          "minimum": 0,
          "title": "Tie Value",
          "type": "number"
        }
      },
      "required": [
        "id",
        "label",
        "formula",
        "direction",
        "comparison_decimals",
        "tie_value"
      ],
      "title": "Category",
      "type": "object"
    },
    "DerivedStat": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "linear",
            "threshold"
          ],
          "title": "Kind",
          "type": "string"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/Term"
          },
          "title": "Terms",
          "type": "array"
        },
        "threshold": {
          "minimum": 0,
          "title": "Threshold",
          "type": "number"
        },
        "minimum_hits": {
          "exclusiveMinimum": 0,
          "title": "Minimum Hits",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "terms",
        "threshold",
        "minimum_hits"
      ],
      "title": "DerivedStat",
      "type": "object"
    },
    "InjurySlot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "eligible_statuses": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Eligible Statuses",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "count",
        "eligible_statuses"
      ],
      "title": "InjurySlot",
      "type": "object"
    },
    "Linear": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "linear",
          "title": "Kind",
          "type": "string"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/Term"
          },
          "minItems": 1,
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "terms"
      ],
      "title": "Linear",
      "type": "object"
    },
    "Matchup": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "phase": {
          "enum": [
            "regular",
            "playoff",
            "postseason"
          ],
          "title": "Phase",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "phase"
      ],
      "title": "Matchup",
      "type": "object"
    },
    "Ratio": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ratio",
          "title": "Kind",
          "type": "string"
        },
        "numerator": {
          "items": {
            "$ref": "#/$defs/Term"
          },
          "minItems": 1,
          "title": "Numerator",
          "type": "array"
        },
        "denominator": {
          "items": {
            "$ref": "#/$defs/Term"
          },
          "minItems": 1,
          "title": "Denominator",
          "type": "array"
        },
        "zero_denominator": {
          "enum": [
            "error",
            "zero",
            "numerator"
          ],
          "title": "Zero Denominator",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "numerator",
        "denominator",
        "zero_denominator"
      ],
      "title": "Ratio",
      "type": "object"
    },
    "Shot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "made": {
          "minLength": 1,
          "title": "Made",
          "type": "string"
        },
        "attempted": {
          "minLength": 1,
          "title": "Attempted",
          "type": "string"
        }
      },
      "required": [
        "id",
        "made",
        "attempted"
      ],
      "title": "Shot",
      "type": "object"
    },
    "StarterSlot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "eligible_positions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Eligible Positions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "eligible_positions"
      ],
      "title": "StarterSlot",
      "type": "object"
    },
    "Term": {
      "additionalProperties": false,
      "properties": {
        "stat_id": {
          "minLength": 1,
          "title": "Stat Id",
          "type": "string"
        },
        "coefficient": {
          "title": "Coefficient",
          "type": "number"
        }
      },
      "required": [
        "stat_id",
        "coefficient"
      ],
      "title": "Term",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "categories": {
      "items": {
        "$ref": "#/$defs/Category"
      },
      "minItems": 1,
      "title": "Categories",
      "type": "array"
    },
    "season_id": {
      "minLength": 1,
      "title": "Season Id",
      "type": "string"
    },
    "timezone": {
      "minLength": 1,
      "title": "Timezone",
      "type": "string"
    },
    "starts_on": {
      "format": "date",
      "title": "Starts On",
      "type": "string"
    },
    "ends_on": {
      "format": "date",
      "title": "Ends On",
      "type": "string"
    },
    "base_stats": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Base Stats",
      "type": "array"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/Shot"
      },
      "title": "Shots",
      "type": "array"
    },
    "derived": {
      "items": {
        "$ref": "#/$defs/DerivedStat"
      },
      "title": "Derived",
      "type": "array"
    },
    "players_on_court": {
      "exclusiveMinimum": 0,
      "title": "Players On Court",
      "type": "integer"
    },
    "regulation_minutes": {
      "exclusiveMinimum": 0,
      "title": "Regulation Minutes",
      "type": "integer"
    },
    "format_version": {
      "const": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "league_id": {
      "minLength": 1,
      "title": "League Id",
      "type": "string"
    },
    "game_key": {
      "minLength": 1,
      "title": "Game Key",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "teams": {
      "minimum": 2,
      "title": "Teams",
      "type": "integer"
    },
    "positions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Positions",
      "type": "array"
    },
    "starter_slots": {
      "items": {
        "$ref": "#/$defs/StarterSlot"
      },
      "minItems": 1,
      "title": "Starter Slots",
      "type": "array"
    },
    "bench_slots": {
      "minimum": 0,
      "title": "Bench Slots",
      "type": "integer"
    },
    "injury_slots": {
      "items": {
        "$ref": "#/$defs/InjurySlot"
      },
      "title": "Injury Slots",
      "type": "array"
    },
    "scoring": {
      "enum": [
        "h2h_one_win",
        "h2h_each_category"
      ],
      "title": "Scoring",
      "type": "string"
    },
    "category_ties": {
      "enum": [
        "exclude",
        "use_tie_value"
      ],
      "title": "Category Ties",
      "type": "string"
    },
    "week_tie_value": {
      "maximum": 1,
      "minimum": 0,
      "title": "Week Tie Value",
      "type": "number"
    },
    "adds_per_week": {
      "minimum": 0,
      "title": "Adds Per Week",
      "type": "integer"
    },
    "effective": {
      "enum": [
        "same_day",
        "next_day"
      ],
      "title": "Effective",
      "type": "string"
    },
    "cutoff_local_time": {
      "format": "time",
      "title": "Cutoff Local Time",
      "type": "string"
    },
    "waiver_days": {
      "minimum": 0,
      "title": "Waiver Days",
      "type": "integer"
    },
    "lineup_lock": {
      "enum": [
        "daily",
        "player_game"
      ],
      "title": "Lineup Lock",
      "type": "string"
    },
    "lineup_lock_time": {
      "format": "time",
      "title": "Lineup Lock Time",
      "type": "string"
    },
    "matchups": {
      "items": {
        "$ref": "#/$defs/Matchup"
      },
      "minItems": 1,
      "title": "Matchups",
      "type": "array"
    },
    "playoff_teams": {
      "exclusiveMinimum": 0,
      "title": "Playoff Teams",
      "type": "integer"
    },
    "playoff_weeks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Playoff Weeks",
      "type": "array"
    },
    "trade_deadline": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Trade Deadline"
    },
    "yahoo_settings_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Yahoo Settings Sha256",
      "type": "string"
    }
  },
  "required": [
    "categories",
    "season_id",
    "timezone",
    "starts_on",
    "ends_on",
    "base_stats",
    "shots",
    "derived",
    "players_on_court",
    "regulation_minutes",
    "format_version",
    "league_id",
    "game_key",
    "name",
    "teams",
    "positions",
    "starter_slots",
    "bench_slots",
    "injury_slots",
    "scoring",
    "category_ties",
    "week_tie_value",
    "adds_per_week",
    "effective",
    "cutoff_local_time",
    "waiver_days",
    "lineup_lock",
    "lineup_lock_time",
    "matchups",
    "playoff_teams",
    "playoff_weeks",
    "trade_deadline",
    "yahoo_settings_sha256"
  ],
  "title": "InseasonLeague",
  "type": "object"
}
