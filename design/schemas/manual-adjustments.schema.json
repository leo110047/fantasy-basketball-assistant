  "additionalProperties": false,
  "properties": {
    "format_version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "adjustments": {
      "items": {
        "$ref": "#/$defs/Adjustment"
      },
      "title": "Adjustments",
      "type": "array"
    }
  },
  "required": [
    "format_version",
    "adjustments"
  ],
  "title": "ManualAdjustments",
  "type": "object"
}
