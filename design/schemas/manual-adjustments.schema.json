{
  "$defs": {
    "Adjustment": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "player_id": {
          "minLength": 1,
          "title": "Player Id",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "effective_from": {
          "format": "date-time",
          "title": "Effective From",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "assumption": {
          "title": "Assumption",
          "type": "boolean"
        },
        "operation": {
          "discriminator": {
            "mapping": {
              "expected_games": "#/$defs/ExpectedGames",
              "multiply": "#/$defs/Multiply",
              "return_at": "#/$defs/ReturnAt"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Multiply"
            },
            {
              "$ref": "#/$defs/ExpectedGames"
            },
            {
              "$ref": "#/$defs/ReturnAt"
            }
          ],
          "title": "Operation"
        }
      },
      "required": [
        "id",
        "player_id",
        "published_at",
        "effective_from",
        "reason",
        "source",
        "assumption",
        "operation"
      ],
      "title": "Adjustment",
      "type": "object"
    },
    "ExpectedGames": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "expected_games",
          "title": "Kind",
          "type": "string"
        },
        "games": {
          "minimum": 0,
          "title": "Games",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "games"
      ],
      "title": "ExpectedGames",
      "type": "object"
    },
    "Multiply": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "multiply",
          "title": "Kind",
          "type": "string"
        },
        "stat_id": {
          "minLength": 1,
          "title": "Stat Id",
          "type": "string"
        },
        "factor": {
          "minimum": 0,
          "title": "Factor",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "stat_id",
        "factor"
      ],
      "title": "Multiply",
      "type": "object"
    },
    "ReturnAt": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "return_at",
          "title": "Kind",
          "type": "string"
        },
        "return_at": {
          "format": "date-time",
          "title": "Return At",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "return_at"
      ],
      "title": "ReturnAt",
      "type": "object"
    }
