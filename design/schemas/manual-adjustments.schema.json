{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fantasy-assistant:manual-adjustments:1",
  "title": "manual-adjustments",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1
    },
    "adjustments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "player_id": {
            "type": "string",
            "minLength": 1
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "effective_from": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "assumption": {
            "type": "boolean"
          },
          "operation": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "multiply"
                  },
                  "stat_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "factor": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "kind",
                  "stat_id",
                  "factor"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "expected_games"
                  },
                  "games": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "kind",
                  "games"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "return_at"
                  },
                  "return_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "kind",
                  "return_at"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "player_id",
          "published_at",
          "effective_from",
          "reason",
          "source",
          "assumption",
          "operation"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "format_version",
    "adjustments"
  ],
  "additionalProperties": false,
  "$defs": {}
}
