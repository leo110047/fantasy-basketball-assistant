{
  "$defs": {
    "CalculationModel": {
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "maximum": 3,
          "minimum": 3,
          "title": "Format Version",
          "type": "integer"
        },
        "calibration": {
          "$ref": "#/$defs/CalibrationMethod"
        },
        "projection": {
          "$ref": "#/$defs/ProjectionParameters"
        },
        "valuation": {
          "$ref": "#/$defs/ValuationParameters"
        }
      },
      "required": [
        "format_version",
        "calibration",
        "projection",
        "valuation"
      ],
      "title": "CalculationModel",
      "type": "object"
    },
    "CalibrationMethod": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "const": "ordinary_least_squares",
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "value",
        "evidence"
      ],
      "title": "CalibrationMethod",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Assumption",
            "source",
            "backtest"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reference",
        "as_of",
        "reason"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ModelConfig": {
      "additionalProperties": false,
      "description": "Stage 1 accepts only settings consumed by snapshot construction.",
      "properties": {
        "format_version": {
          "maximum": 1,
          "minimum": 1,
          "title": "Format Version",
          "type": "integer"
        },
        "calibration": {
          "$ref": "#/$defs/CalibrationMethod"
        }
      },
      "required": [
        "format_version",
        "calibration"
      ],
      "title": "ModelConfig",
      "type": "object"
    },
    "NestedCount": {
      "additionalProperties": false,
      "properties": {
        "child": {
          "minLength": 1,
          "title": "Child",
          "type": "string"
        },
        "parent": {
          "minLength": 1,
          "title": "Parent",
          "type": "string"
        }
      },
      "required": [
        "child",
        "parent"
      ],
      "title": "NestedCount",
      "type": "object"
    },
    "PriorWeight": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "weight": {
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "id",
        "weight"
      ],
      "title": "PriorWeight",
      "type": "object"
    },
    "ProjectionParameters": {
      "additionalProperties": false,
      "properties": {
        "stat_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Stat Ids",
          "type": "array"
        },
        "rounding_groups": {
          "items": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "title": "Rounding Groups",
          "type": "array"
