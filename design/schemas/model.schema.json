        "scoring_terms": {
          "items": {
            "$ref": "#/$defs/Term"
          },
          "title": "Scoring Terms",
          "type": "array"
        },
        "threshold_stat": {
          "minLength": 1,
          "title": "Threshold Stat",
          "type": "string"
        },
        "count_pseudocount": {
          "minimum": 0,
          "title": "Count Pseudocount",
          "type": "number"
        },
        "attempt_pseudocount": {
          "minimum": 0,
          "title": "Attempt Pseudocount",
          "type": "number"
        },
        "search_iterations": {
          "exclusiveMinimum": 0,
          "title": "Search Iterations",
          "type": "integer"
        },
        "integration_batch_size": {
          "exclusiveMinimum": 0,
          "title": "Integration Batch Size",
          "type": "integer"
        },
        "feasibility_tolerance": {
          "minimum": 0,
          "title": "Feasibility Tolerance",
          "type": "number"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "prior_weights": {
          "items": {
            "$ref": "#/$defs/PriorWeight"
          },
          "title": "Prior Weights",
          "type": "array"
        }
      },
      "required": [
        "stat_ids",
        "rounding_groups",
        "nested_counts",
        "scoring_stat",
        "scoring_terms",
        "threshold_stat",
        "count_pseudocount",
        "attempt_pseudocount",
        "search_iterations",
        "integration_batch_size",
        "feasibility_tolerance",
        "evidence",
        "prior_weights"
      ],
      "title": "ProjectionParameters",
      "type": "object"
    },
