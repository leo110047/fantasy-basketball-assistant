{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "field_path",
        "evidence"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Columns": {
      "additionalProperties": false,
      "properties": {
        "player_id": {
          "minLength": 1,
          "title": "Player Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "positions": {
          "minLength": 1,
          "title": "Positions",
          "type": "string"
        },
        "rank": {
          "minLength": 1,
          "title": "Rank",
          "type": "string"
        },
        "projected_price": {
          "minLength": 1,
          "title": "Projected Price",
          "type": "string"
        },
        "average_price": {
          "minLength": 1,
          "title": "Average Price",
          "type": "string"
        }
      },
      "required": [
        "player_id",
        "name",
        "positions",
        "rank",
        "projected_price",
        "average_price"
      ],
      "title": "Columns",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Assumption",
            "source",
            "backtest"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reference",
        "as_of",
        "reason"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Linear": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "linear",
          "title": "Kind",
          "type": "string"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/Term"
          },
          "minItems": 1,
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "terms"
      ],
      "title": "Linear",
      "type": "object"
    },
    "ManualCapture": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "retrieved_at"
      ],
      "title": "ManualCapture",
      "type": "object"
    },
    "Observed": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "observed",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Observed",
      "type": "object"
    },
    "RosterImport": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "format": {
          "enum": [
            "csv",
            "yahoo_export"
          ],
          "title": "Format",
          "type": "string"
        },
        "encoding": {
          "minLength": 1,
          "title": "Encoding",
          "type": "string"
        },
        "delimiter": {
          "maxLength": 1,
          "minLength": 1,
          "title": "Delimiter",
          "type": "string"
        },
        "columns": {
          "$ref": "#/$defs/Columns"
        }
      },
      "required": [
        "path",
        "format",
        "encoding",
        "delimiter",
        "columns"
      ],
      "title": "RosterImport",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "projections",
            "game_logs",
            "schedule",
            "rosters",
            "official_schedule_counts",
            "historical_projections",
            "forecast_archive"
          ],
          "title": "Role",
          "type": "string"
        },
        "adapter": {
          "minLength": 1,
          "title": "Adapter",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "season_code": {
          "minLength": 1,
          "title": "Season Code",
          "type": "string"
        },
        "season_id": {
          "minLength": 1,
          "title": "Season Id",
          "type": "string"
        },
        "available_as_of": {
          "format": "date-time",
          "title": "Available As Of",
          "type": "string"
        },
        "delivery": {
          "enum": [
            "fetch",
            "manual"
          ],
          "title": "Delivery",
          "type": "string"
        },
        "manual_file": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Manual File"
        },
        "manual_capture": {
          "anyOf": [
            {
              "$ref": "#/$defs/ManualCapture"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "role",
        "adapter",
        "url",
        "season_code",
        "season_id",
        "available_as_of",
        "delivery",
        "manual_file",
        "manual_capture"
      ],
      "title": "Source",
      "type": "object"
    },
    "StatDefinition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "enum": [
            "count",
            "minutes",
            "games"
          ],
          "title": "Unit",
          "type": "string"
        },
        "definition": {
          "discriminator": {
            "mapping": {
              "linear": "#/$defs/Linear",
              "observed": "#/$defs/Observed",
              "threshold_count": "#/$defs/ThresholdCount"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Observed"
            },
            {
              "$ref": "#/$defs/Linear"
            },
            {
              "$ref": "#/$defs/ThresholdCount"
            }
          ],
          "title": "Definition"
        }
      },
      "required": [
        "id",
        "label",
        "unit",
        "definition"
      ],
      "title": "StatDefinition",
      "type": "object"
    },
    "Term": {
      "additionalProperties": false,
      "properties": {
        "stat_id": {
          "minLength": 1,
          "title": "Stat Id",
          "type": "string"
        },
        "coefficient": {
          "title": "Coefficient",
          "type": "number"
        }
      },
      "required": [
        "stat_id",
        "coefficient"
      ],
      "title": "Term",
      "type": "object"
    },
    "ThresholdCount": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "threshold_count",
          "title": "Kind",
          "type": "string"
        },
        "stat_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Stat Ids",
          "type": "array"
        },
        "threshold": {
          "minimum": 0,
          "title": "Threshold",
          "type": "number"
        },
        "minimum_hits": {
          "exclusiveMinimum": 0,
          "title": "Minimum Hits",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "stat_ids",
        "threshold",
        "minimum_hits"
      ],
      "title": "ThresholdCount",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "season_id": {
      "minLength": 1,
      "title": "Season Id",
      "type": "string"
    },
    "starts_on": {
      "format": "date",
      "title": "Starts On",
      "type": "string"
    },
    "ends_on": {
      "format": "date",
      "title": "Ends On",
      "type": "string"
    },
    "snapshot_as_of": {
      "format": "date-time",
      "title": "Snapshot As Of",
      "type": "string"
    },
    "previous_season_id": {
      "minLength": 1,
      "title": "Previous Season Id",
      "type": "string"
    },
    "roster_import": {
      "$ref": "#/$defs/RosterImport"
    },
    "identity_map_path": {
      "minLength": 1,
      "title": "Identity Map Path",
      "type": "string"
    },
    "manual_adjustments_path": {
      "minLength": 1,
      "title": "Manual Adjustments Path",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "stat_definitions": {
      "items": {
        "$ref": "#/$defs/StatDefinition"
      },
      "minItems": 1,
      "title": "Stat Definitions",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    }
  },
  "required": [
    "format_version",
    "season_id",
    "starts_on",
    "ends_on",
    "snapshot_as_of",
    "previous_season_id",
    "roster_import",
    "identity_map_path",
    "manual_adjustments_path",
    "sources",
    "stat_definitions",
    "assumptions"
  ],
  "title": "SeasonConfig",
  "type": "object"
}
